    "header_names": ["Accept", "Accept-Encoding", "Accept-Language", "App-Name", "Authorization",
      "Origin", "Sec-Fetch-Dest", "Sec-Fetch-Mode", "Sec-Fetch-Site", "User-Agent",
      "X-App-Platform", "X-App-Version", "X-App-fr", "X-Device-Brand", "X-Device-Model",
