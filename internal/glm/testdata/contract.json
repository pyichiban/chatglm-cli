  "known_divergences": [
    {"id": "V1", "topic": "40012 退避重试",
     "python": "默认指数退避重试 4 次（MAX_RETRIES=4，RETRY_BASE_DELAY=1.0，含抖动）",
     "go": "不重试，直接返回 transient_rejection（exit 4）",
     "aligned_to_goal1": false},
    {"id": "V2", "topic": "refer__991 支持",
     "python": "仍保留 Credential.refer_991 / GLM_REFER_991，命中时拼进 query",
     "go": "彻底移除，无该字段",
     "aligned_to_goal1": false},
    {"id": "V3", "topic": "Accept-Encoding",
