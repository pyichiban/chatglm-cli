    "refresh": "/chatglm/user-api/user/refresh",
    "user_info": "/chatglm/user-api/user/info",
    "models": "/chatglm/agent-api/operation/detail",
    "conv_list": "/chatglm/mainchat-api/conversation/recent_list",
    "chat": "/chatglm/backend-api/assistant/stream",
    "history": "/chatglm/mainchat-api/conversation/messages",
    "history_v2_dead": "/chatglm/agent-api/conversation/page_messages_v2",
    "bulk_delete": "/chatglm/mainchat-api/conversation/bulk_delete",
    "modify_title": "/chatglm/mainchat-api/conversation/modify_title",
    "conv_title": "/chatglm/mainchat-api/conversation/title",
    "update_status": "/chatglm/mainchat-api/stream/update_status",
    "stop_stream": "/chatglm/mainchat-api/stream/stop_stream",
    "edit": "/chatglm/drawing-api/v1/image/reference"
