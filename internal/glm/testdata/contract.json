  "defaults": {
    "base": "https://chatglm.cn",
    "model": "glm-5.3-flash",
    "chat_type": "user_chat",
    "page_size": 20,
    "history_page_size_v2": 30,
    "meta_platform": "pc",
    "left_score_unit": "分（原样返回，不折算：目前不消耗积分）",
    "cid_pattern": "^[0-9a-f]{24}$"
  },

  "codes": { "transient": 40012, "auth": [40102, 40103] },

  "timeouts": {
    "connect_sec": 15, "read_sec": 60, "auth_skew_sec": 300,
    "stream_total_timeout": null,
    "rule": "流式请求不得设任何总超时；截断必须报错，不得伪造收尾帧"
  },

  "retry": {
    "enabled": false,
    "rule": "不退避重试（IDE 链路实测稳定）：命中 40012 直接报 transient_rejection；HTTP 401 自愈（刷新凭据后只重试一次）"
  },

  "env": {
    "refresh_token": "GLM_REFRESH_TOKEN", "access_token": "GLM_ACCESS_TOKEN",
    "device_id": "GLM_DEVICE_ID", "user_id": "GLM_USER_ID", "cookie": "GLM_COOKIE",
    "credential_file": "GLM_CREDENTIAL_FILE"
  },

  "cookies": {
    "business": ["chatglm_token", "chatglm_refresh_token", "chatglm_user_id"],
    "waf_drop_keys": ["acw_tc", "cdn_sec_tc", "chatglm_token_expires", "_c_WBKFRo", "_nb_ioWEgULi"],
    "waf_drop_prefix": ["ssxmod", "_c_", "_nb_"]
  },

  "credential_file": {
    "keys": ["refresh_token", "access_token", "device_id", "user_id", "extra_cookies"],
    "write": "tmp + rename 原子替换；写前重读磁盘，refresh 与本次依据不一致则拒绝覆盖（并发保护）",
    "preserve_unknown_keys": true,
    "must_persist_after_refresh": true
  },

  "pagination": {
    "conversation_list": "客户端内部按 page/page_size 翻页直到 has_more=false，对外一次返回完整列表（调用方不感知分页）",
    "conversation_messages": "上游一次返回全量升序消息，无分页",
    "rule": "凡列表类接口，实现层必须内部翻页，外部只见完整列表"
  },

  "chat_body": {
    "top_keys": ["assistant_id", "conversation_id", "project_id", "chat_type", "meta_data", "messages"],
    "meta_keys": ["channel", "chat_mode", "cogview", "draft_id", "input_question_type", "is_networking",
                  "is_test", "platform", "quote_log_id", "selected_model"],
    "cogview_base_keys": ["rm_label_watermark"],
    "rm_label_watermark": true,
    "cogview_drawing_keys": ["aspect_ratio", "style", "scene"],
    "messages_len": 1,
    "first_turn_conversation_id": "",
    "reasoning_effort_optional": true
  },

  "request_shapes": {
    "history": {"method": "GET", "endpoint": "history", "query": ["assistant_id", "conversation_id"],
                "pagination_params": [], "note": "升序全量返回，page_size/page 实测被忽略"},
    "history_v2": {"method": "GET", "endpoint": "history_v2_dead",
                   "query": ["assistant_id", "conversation_id", "page_size"]},
    "conv_list": {"method": "POST", "endpoint": "conv_list", "body_keys": ["page", "page_size"],
                  "note": "原始单页请求；对外 API 应使用内部翻页的完整列表封装"},
    "rename": {"method": "POST", "endpoint": "modify_title", "body_keys": ["conversation_id", "title"]},
    "conv_title": {"method": "GET", "endpoint": "conv_title", "query": ["conversation_id"]},
    "bulk_delete": {"method": "POST", "endpoint": "bulk_delete",
                    "body_keys": ["assistant_id", "conversation_ids"],
                    "note": "assistant_id 不匹配则上游静默无效（返回成功但没删）"},
    "stop_stream": {"method": "POST", "endpoint": "stop_stream", "body_keys": ["history_id"]},
    "update_status": {"method": "POST", "endpoint": "update_status", "body_keys": ["history_id"]},
    "refresh": {"method": "POST", "endpoint": "refresh", "body": {},
                "auth_token": "refresh_token", "rotates_refresh_token": "sometimes"},
    "edit": {"method": "POST", "endpoint": "edit",
             "body_keys": ["assistant_id", "aspect_ratio", "category", "conversation_id",
                           "file_id", "history_id", "if_plus_model", "image_url",
                           "prompt", "rm_label_watermark", "title", "type"],
             "note": "同步长请求 17~22s；单图接口；输出比例跟随输入图；image_url 必须上游可达"}
  },

  "image_pipeline": {
    "command": "image",
    "blocking": true,
    "refs_composite": {"budget_pixels": 4800000, "format": "jpeg", "quality": 92,
                       "layout": "justified-rows：按宽高比贪心分行，行内等高、二分搜索最大画宽，内容像素最大化（单图放大上限 4 倍）",
                       "outline": "方形外框，画在图像外侧（外扩 6px、线宽 4px），不遮有效像素",
                       "labels": "图像下方标注条 reference1..N（白字 3x basicfont）"},
    "upload": {"primary": "file.sang.pub meitu 通道（落地 meitudata.com）",
               "fallback": "file.sang.pub icve 通道（落地 file.icve.com.cn）",
               "body": "raw binary（非 multipart）+ X-Upload-Type/X-File-Name/X-File-Size 头"},
    "rm_label_watermark": {"hardcoded": true,
                           "evidence": "实证 2026-10-16：false 产物带「清言·AI生成」角标，true 无；两仓写死 true，永不产带水印图"},
    "zero_refs": "走 chat 通道 drawing agent（cogview），一次返回最多 4 图",
    "output": "产物下载后按 --out 落盘；非 JPEG/PNG 直接报错"
  },

  "sse_rules": {
    "done_sentinel": false,
    "finish_marker": "顶层 status==\"finish\"",
    "part_status": {"init": "增量 delta", "finish": "该段权威全文"},
    "part_key_precedence": ["logic_id", "id", "#index"],
    "content_text_types": ["text", "code", "execution_output"],
    "content_think_types": ["think", "tool_result", "quote_result"],
    "content_image_type": "image",
    "noise_line": "生图流末尾有一行不带 data: 前缀的裸 JSON 信封 {\"status\":0,...,\"rid\":...}，必须忽略",
    "truncation": "未见 finish/error 即 EOF ⇒ 报 stream_truncated，禁止补结束帧；raw 透传形态也必须做同样校验",
    "usage_fields": null
  },

  "python_result_keys": ["conversation_id", "history_id", "text", "thinking", "parts",
                         "finished", "error", "frames"],

  "python_turn_keys": ["message_id", "created_at", "user", "text", "reasoning", "images", "status"],

  "cli_event_contract": {
    "version": 1,
    "types": ["meta", "text", "reasoning", "image", "item", "result", "done", "warn", "error"],
    "first_event": "meta",
    "last_event": "done | error（二者互斥）",
    "fields": {
      "meta": ["v", "type", "request_id", "conversation_id", "message_id", "agent_id", "model", "new", "cmd", "ts"],
      "text": ["v", "type", "request_id", "part", "delta"],
      "reasoning": ["v", "type", "request_id", "part", "delta"],
      "image": ["v", "type", "request_id", "part", "url", "polished_prompt", "index"],
      "done": ["v", "type", "request_id", "conversation_id", "message_id", "agent_id", "model",
               "cmd", "new", "frames", "elapsed_ms", "finished", "images", "text_chars", "reasoning_chars"],
      "error": ["v", "type", "code", "message", "detail", "retryable", "http_status", "biz_status", "request_id"]
    }
  },

  "exit_codes": {
    "ok": 0, "upstream_error": 1, "usage_error": 2, "auth_error": 3,
    "transient_rejection": 4, "stream_truncated": 5, "rate_limited": 6, "not_proven": 7
  },

